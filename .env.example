# ---------------------------------------------------------------
# QK Equipment Tracking — frontend environment
#
# Copy this file to `.env` and fill in the values.
# Everything here is PUBLIC (it ships in the browser bundle).
# Never put a service-role key or an SMTP password in this file.
# ---------------------------------------------------------------

# Supabase project URL and publishable (anon) key.
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://mhxkxuczgybdoiglodvu.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public base URL of this app. Used to build the return links that go
# into reminder emails. No trailing slash.
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
VITE_APP_URL=http://localhost:5173
